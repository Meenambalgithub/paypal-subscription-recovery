# Copy to .env and fill in. Never commit .env.

# PayPal sandbox: developer.paypal.com > Apps & Credentials (Sandbox), app owned by a US Business account
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Printed by setup_webhook.py
PAYPAL_WEBHOOK_ID=

# Local infrastructure (infra/docker-compose.yml)
KAFKA_BOOTSTRAP=localhost:9092
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://recovery:recovery@localhost:5432/recovery
SMTP_HOST=localhost
SMTP_PORT=1025

# The agent: free Gemini key from https://aistudio.google.com > Get API key
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODEL=gemini-2.5-flash

# Quiet hours (21:00-08:00) use this time zone. Set QUIET_HOURS=off to test at any hour.
CUSTOMER_TZ=Asia/Kolkata
QUIET_HOURS=on

# Customer reply links point here; they're signed with REPLY_SECRET (generated into .reply_secret if empty)
APP_BASE_URL=http://localhost:8000
REPLY_SECRET=
